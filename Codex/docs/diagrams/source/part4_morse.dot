digraph Morse {

    graph [bgcolor="#ffffff", fontname="DejaVu Sans", fontsize=22,
           labelloc=t, pad="0.4", nodesep="1.0", ranksep="0.85", dpi=120];
    node [fontname="DejaVu Sans", fontsize=13, color="#475569",
          penwidth=1.5, style=filled, fillcolor="#f1f5f9", margin="0.16,0.12"];
    edge [fontname="DejaVu Sans", fontsize=12, color="#64748b", penwidth=1.5,
          arrowsize=0.8];

    rankdir=LR;
    label="Part IV - Morse encoder state machine";
    node [shape=ellipse];
    entry [shape=point, width=0.1, label=""];
    IDLE [label="IDLE\nLEDR0 off\nWait for a new start press", fillcolor="#f1f5f9"];
    PULSE [label="PULSE\nLEDR0 on\nDot: 0.5 s / Dash: 1.5 s", fillcolor="#fef3c7"];
    GAP [label="GAP\nLEDR0 off\nWait 0.5 s between symbols", fillcolor="#e0f2fe"];
    entry -> IDLE [label="reset"];
    IDLE -> IDLE [label="No new start press"];
    IDLE -> PULSE [label="New KEY1 press\nCapture letter and length\nLoad 1 tick (dot) or 3 ticks (dash)"];
    PULSE -> PULSE [label="No tick: wait\nTick with > 1 unit left: subtract 1"];
    PULSE -> GAP [label="Tick finishes symbol; more remain\nShift to next symbol\nSubtract 1 from remaining"];
    GAP -> GAP [label="No tick: wait"];
    GAP -> PULSE [label="Half-second tick\nLoad next symbol's duration"];
    PULSE -> IDLE [label="Tick finishes FINAL symbol\nRemaining becomes 0", color="#b45309", fontcolor="#b45309"];
    note [shape=box, fillcolor="#f8fafc", fontsize=12, label="One tick = 0.5 seconds; all state changes use CLOCK_50.\nKEY0 press resets ANY state to IDLE immediately.\nStart presses observed during PULSE or GAP are ignored.\nHeld KEY1 does not repeat playback."];
    GAP -> note [style=invis];
}
